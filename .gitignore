# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env & secrets — never commit real credentials
.env
.env.*
!.env.example
!.env*.example
*.local
credentials.json
**/serviceAccount*.json
**/secrets/

# local DB dumps / backups
*.dump
*.backup
*.sql.bak
/backups/
/tmp/

# docker local overrides (often hold host-specific secrets)
docker-compose.override.yml

# vercel / IDE / local-only project docs & Cursor rules
.vercel
.idea/
.cursor/
/docs/

# uploaded home banners (keep folder via .gitkeep)
/public/banners/*
!/public/banners/.gitkeep

# runtime app data (banner index, local uploads) — keep folder via .gitkeep
/data/*
!/data/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
