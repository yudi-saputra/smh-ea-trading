// Prisma schema — SMH Dashboard (F00 / F01 / F02 / F03 / F06)
// URL lives in prisma.config.ts (Prisma 7)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CommandStatus {
  PENDING
  ACKED
  FAILED
}

enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
}

model Package {
  id          String        @id @default(cuid())
  name        String
  description String        @default("")
  status      PackageStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members   Member[]
  terminals Terminal[] @relation("TerminalPackage")
}

model Affiliate {
  id        String          @id @default(cuid())
  /** Referral code used in register URL / form (unique, uppercase stored). */
  code      String          @unique
  name      String
  email     String          @unique
  phone     String?
  status    AffiliateStatus @default(ACTIVE)
  notes     String          @default("")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  members Member[]

  @@map("affiliates")
}

model Member {
  id              String       @id @default(cuid())
  packageId       String       @map("package_id")
  affiliateId     String?      @map("affiliate_id")
  name            String
  email           String       @unique
  /** bcrypt hash (legacy plaintext rows rehashed on next login). */
  password        String
  idTrading       String       @map("id_trading")
  passwordTrading String       @map("password_trading")
  serverBroker    String       @map("server_broker")
  status          MemberStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")

  package        Package         @relation(fields: [packageId], references: [id])
  affiliate      Affiliate?      @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  sessions       MemberSession[]
  ownedTerminals Terminal[]      @relation("TerminalMemberOwner")
  commands       Command[]       @relation("CommandMemberActor")

  @@index([packageId])
  @@index([affiliateId])
  @@map("members")
}

model MemberSession {
  id         String    @id @default(cuid())
  memberId   String    @map("member_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  userAgent  String?   @map("user_agent") @db.Text
  ip         String?   @db.VarChar(64)
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_sessions")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(ACTIVE)
  displayName  String?    @map("display_name")
  createdById  String?    @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  createdBy          User?      @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers       User[]     @relation("UserCreatedBy")
  ownedTerminals     Terminal[] @relation("TerminalOwner")
  createdTerminals   Terminal[] @relation("TerminalCreator")
  commands           Command[]  @relation("CommandActor")
  sessions           Session[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  userAgent  String?   @map("user_agent") @db.Text
  ip         String?   @db.VarChar(64)
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Terminal {
  id            String    @id @default(cuid())
  terminalId    String    @unique @map("terminal_id") // [A-Za-z0-9_-] — matches MQ5 TerminalId
  name          String
  apiKeyHash    String    @map("api_key_hash")
  /** AES-GCM ciphertext for Super Admin reveal; null on legacy rows until rotate. */
  apiKeyEnc     String?   @map("api_key_enc")
  /** Legacy User owner — prefer ownerMemberId for new terminals. */
  ownerUserId   String?   @map("owner_user_id")
  ownerMemberId String?   @map("owner_member_id")
  /** Package for this EA account (per-terminal; multi-akun can differ). */
  packageId     String?   @map("package_id")
  /** MT login credentials for this terminal (not shared with sibling accounts). */
  passwordTrading String? @map("password_trading")
  serverBroker    String? @map("server_broker")
  createdById  String    @map("created_by_id")
  enabled       Boolean   @default(true)
  expiresAt     DateTime? @map("expires_at") // null = no expiry; licence end (UTC)
  lastSeenAt    DateTime? @map("last_seen_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner       User?             @relation("TerminalOwner", fields: [ownerUserId], references: [id])
  memberOwner Member?           @relation("TerminalMemberOwner", fields: [ownerMemberId], references: [id])
  eaPackage   Package?          @relation("TerminalPackage", fields: [packageId], references: [id], onDelete: SetNull)
  createdBy   User              @relation("TerminalCreator", fields: [createdById], references: [id])
  snapshot    TerminalSnapshot?
  commands    Command[]

  @@index([ownerUserId])
  @@index([ownerMemberId])
  @@index([packageId])
  @@map("terminals")
}

model TerminalSnapshot {
  id         String   @id @default(cuid())
  terminalId String   @unique @map("terminal_id")
  status     String   // on | off | paused
  account    BigInt?
  symbol     String?
  balance    Decimal? @db.Decimal(18, 2)
  equity     Decimal? @db.Decimal(18, 2)
  positions  Int      @default(0)
  buy        Int      @default(0)
  sell       Int      @default(0)
  floatPnl   Decimal? @map("float_pnl") @db.Decimal(18, 2)
  dailyPnl   Decimal? @map("daily_pnl") @db.Decimal(18, 2)
  layer      Decimal? @db.Decimal(18, 2)
  multiplier Decimal? @db.Decimal(18, 4)
  target     Decimal? @db.Decimal(18, 2)
  cutloss    Decimal? @db.Decimal(18, 2)
  mode       Int? // 0 conservative, 1 aggressive
  entryMode  Int?     @map("entry_mode") // 0 two-way, 1 one-way
  maxLot     Decimal? @map("max_lot") @db.Decimal(18, 4)
  maxLayer   Int?     @map("max_layer")
  tradeTime  Boolean? @map("trade_time") // null/unknown until heartbeat; schedule enabled
  tradeStartMin Int?  @map("trade_start_min") // minutes from midnight WIB
  tradeEndMin   Int?  @map("trade_end_min")
  rawJson    Json?    @map("raw_json")
  updatedAt  DateTime @updatedAt @map("updated_at")

  terminal Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@map("terminal_snapshots")
}

model Command {
  id             String        @id @default(cuid())
  terminalId     String        @map("terminal_id")
  text           String // e.g. /on, /setlayer 500
  status         CommandStatus @default(PENDING)
  resultMessage  String?       @map("result_message")
  actorUserId    String?       @map("actor_user_id")
  actorMemberId  String?       @map("actor_member_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  ackedAt        DateTime?     @map("acked_at")

  terminal    Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  actor       User?    @relation("CommandActor", fields: [actorUserId], references: [id])
  actorMember Member?  @relation("CommandMemberActor", fields: [actorMemberId], references: [id])

  @@index([terminalId, status, createdAt])
  @@map("commands")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String? @map("actor_user_id")
  action     String
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@map("audit_logs")
}
