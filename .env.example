# Copy to `.env` and edit. Never commit `.env`.

# --- Postgres (used by docker compose) ---
POSTGRES_USER="smh"
POSTGRES_PASSWORD="replace-with-strong-password"
POSTGRES_DB="smh_dashboard"

# --- App ---
# Local `npm run dev` (Postgres di mesin / published port):
DATABASE_URL="postgresql://smh:replace-with-strong-password@127.0.0.1:5432/smh_dashboard?schema=public"
# Di Docker, compose men-override host menjadi `db` otomatis.

# Super Admin seed
SEED_ADMIN_EMAIL="admin@smhcloud.my.id"
SEED_ADMIN_PASSWORD="replace-with-strong-password"

# Encrypt ApiKeys at rest (admin reveal). Set this in production.
API_KEY_SECRET="replace-with-long-random-string-32chars-min"
